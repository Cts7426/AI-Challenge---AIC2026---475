+"""Knob vận hành cho KIS multi-anchor, tách khỏi caller để replay được."""
+
+ENABLED = True
+MAX_ANCHORS = 3
+MAX_CLIP_TOKENS = 60
+RRF_K = 7
+TEMPORAL_BONUS = 1.25
+PER_ANCHOR_POOL = 100
+
