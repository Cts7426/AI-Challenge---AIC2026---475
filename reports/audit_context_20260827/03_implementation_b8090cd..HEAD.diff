+class GroundTruthWithVerification(Protocol):
+    """Tối thiểu metadata cần có để gate biết nhãn có được xác minh hay chưa."""
+
+    query_id: str
+    verification_status: str
+    provenance: str | None
+    verified_by: str | None
+    verified_at: str | None
+
