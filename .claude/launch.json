{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "backend.api.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "debug-ui",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "streamlit", "run", "app/debug_ui.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
